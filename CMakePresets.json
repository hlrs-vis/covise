{
  "version": 3,
  "configurePresets": [
    {
      "name": "ninja-multi",
      "generator": "Ninja Multi-Config",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/ninja-multi",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "ninja",
      "generator": "Ninja",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/ninja",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "msvc-buildtools-18",
      "generator": "Visual Studio 18 2026",
      "hidden": true,
      "displayName": "Use MSVC Build Tools 18",
      "binaryDir": "${sourceDir}/build/msvc-buildtools-18",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "ccache",
      "hidden": true,
      "cacheVariables": { 
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": { 
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++" 
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": { 
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++" 
      }
    },
    {
      "name": "lld",
      "hidden": true,
      "displayName": "Use LLD Linker",
      "cacheVariables": {
        "CMAKE_LINKER_TYPE": "LLD",
        "CMAKE_C_USING_LINKER_LLD": "-fuse-ld=lld",
        "CMAKE_CXX_USING_LINKER_LLD": "-fuse-ld=lld"
      }
    },
    {
      "name": "ninja-multi-ccache-clang",
      "inherits": [ "ninja-multi", "clang", "ccache"]
    },
    {
      "name": "ninja-multi-ccache-clang-lld",
      "inherits": [ "ninja-multi", "clang", "ccache", "lld"]
    },
    {
      "name": "ninja-multi-ccache-gcc",
      "inherits": [ "ninja-multi", "gcc", "ccache"]
    },
    {
      "name": "ninja-ccache-clang",
      "inherits": [ "ninja", "clang", "ccache"]
    },
    {
      "name": "ninja-ccache-clang-lld",
      "inherits": [ "ninja", "clang", "ccache", "lld"]
    },
    {
      "name": "ninja-ccache-gcc",
      "inherits": [ "ninja", "gcc", "ccache"]
    },
    {
      "name": "msvc_18_buildtools",
      "displayName": "MSVC 18 Buildtools",
      "inherits": [ "msvc-buildtools-18"]
    },
    {
      "name": "msvc_18_buildtools-llvm",
      "displayName": "MSVC 18 Buildtools with LLVM (clang, lld)",
      "inherits": [ "msvc-buildtools-18", "clang", "lld"]
    }
  ],
  "buildPresets": [
    {
      "name": "debug-build",
      "configurePreset": "ninja-multi-ccache-clang-lld",
      "configuration": "Debug"
    },
    {
      "name": "release-build",
      "configurePreset": "ninja-multi-ccache-clang-lld",
      "configuration": "Release"
    },
    {
      "name": "relwithdeb-build",
      "configurePreset": "ninja-multi-ccache-clang-lld",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "msvc_18-relwithdeb-build",
      "configurePreset": "msvc_18_buildtools",
      "configuration": "RelWithDebInfo",
      "jobs": 0
    },
    {
      "name": "msvc_18-release-build",
      "configurePreset": "msvc_18_buildtools",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "msvc_18-debug-build",
      "configurePreset": "msvc_18_buildtools",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "msvc_18-llvm-relwithdeb-build",
      "configurePreset": "msvc_18_buildtools-llvm",
      "configuration": "RelWithDebInfo",
      "jobs": 0
    },
    {
      "name": "msvc_18-llvm-release-build",
      "configurePreset": "msvc_18_buildtools-llvm",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "msvc_18-llvm-debug-build",
      "configurePreset": "msvc_18_buildtools-llvm",
      "configuration": "Debug",
      "jobs": 0
    }
  ]
}