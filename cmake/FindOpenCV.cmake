# - Find OPENCV
# Find the OPENCV includes and library
#
#  OPENCV_INCLUDE_DIR - Where to find OPENCV includes
#  OPENCV_LIBRARIES   - List of libraries when using OPENCV
#  OPENCV_FOUND       - True if OPENCV was found

IF(OPENCV_INCLUDE_DIR)
  SET(OPENCV_FIND_QUIETLY TRUE)
ENDIF(OPENCV_INCLUDE_DIR)

IF(COVISE_USE_OPENCV5)
    set(MAJOR 5)
    set(SUFFIXES opencv5)
    SET(OPENCV_EXTERNLIBS $ENV{EXTERNLIBS}/opencv5)
ELSEIF(COVISE_USE_OPENCV4)
    set(MAJOR 4)
    set(SUFFIXES opencv4)
    SET(OPENCV_EXTERNLIBS $ENV{EXTERNLIBS}/opencv4)
ELSEIF(COVISE_USE_OPENCV3)
    set(MAJOR 3)
    set(SUFFIXES opencv3)
    SET(OPENCV_EXTERNLIBS $ENV{EXTERNLIBS}/opencv3)
ELSE()
    SET(OPENCV_EXTERNLIBS $ENV{EXTERNLIBS}/OpenCV/build)
    set(SUFFIXES opencv4 opencv3)
ENDIF()


FIND_PATH(OPENCV${MAJOR}_INCLUDE_DIR "opencv2/core/core.hpp"
  HINTS
  ${OPENCV_EXTERNLIBS}/include
  $ENV{OPENCV_HOME}/include
  DOC "OpenCV - Headers"
  PATH_SUFFIXES ${SUFFIXES}
)

INCLUDE(FindPackageHandleStandardArgs)

MACRO(FIND_OPENCV_COMPONENT component version)

STRING(TOUPPER ${component} _uppercomponent)
SET(OPENCV_NAMES opencv_${component}${version} opencv_${component})
SET(OPENCV_WOV_NAMES opencv_${component})
SET(OPENCV_DBG_NAMES opencv_${component}${version}d)

  FIND_LIBRARY(OPENCV${MAJOR}_${_uppercomponent}_LIBRARY NAMES ${OPENCV_NAMES}
  HINTS
  ${OPENCV_EXTERNLIBS}
  $ENV{OPENCV_HOME}
  ${OPENCV_EXTERNLIBS}/x64/vc17
  ${OPENCV_EXTERNLIBS}/x64/vc14
  ${OPENCV_EXTERNLIBS}/x64/vc12
  ${OPENCV_EXTERNLIBS}/x64/vc11
  ${OPENCV_EXTERNLIBS}/x64/vc10
  PATH_SUFFIXES lib lib64
  DOC "OPENCV - Library"
)
  if(NOT ${OPENCV${MAJOR}_${_uppercomponent}_LIBRARY})
    FIND_LIBRARY(OPENCV${MAJOR}_${_uppercomponent}_LIBRARY NAMES ${OPENCV_NAMES}
      PATH_SUFFIXES opencv${MAJOR}
      DOC "OPENCV - Library"
    )
  endif()

IF(MSVC)
  # VisualStudio needs a debug version
  #MESSAGE(${OPENCV_DBG_NAMES})
  FIND_LIBRARY(OPENCV${MAJOR}_${_uppercomponent}_LIBRARY_DEBUG NAMES ${OPENCV_DBG_NAMES}
    HINTS
    ${OPENCV_EXTERNLIBS}
    $ENV{OPENCV_HOME}/lib
    ${OPENCV_EXTERNLIBS}/x64/vc17/lib
    ${OPENCV_EXTERNLIBS}/x64/vc14/lib
    ${OPENCV_EXTERNLIBS}/x64/vc12/lib
    ${OPENCV_EXTERNLIBS}/x64/vc11/lib
    ${OPENCV_EXTERNLIBS}/x64/vc10/lib
    PATH_SUFFIXES debug/lib debug/lib64 lib lib64
    DOC "OPENCV - Library (Debug)"
  )
  
  IF(OPENCV${MAAJOR}_${_uppercomponent}_LIBRARY_DEBUG AND OPENCV${MAJOR}_${_uppercomponent}_LIBRARY)
    SET(OPENCV${MAJOR}_LIBRARIES ${OPENCV${MAJOR}_LIBRARIES} optimized ${OPENCV${MAJOR}_${_uppercomponent}_LIBRARY} debug ${OPENCV${MAJOR}_${_uppercomponent}_LIBRARY_DEBUG})
  ENDIF()

  FIND_PACKAGE_HANDLE_STANDARD_ARGS(OPENCV${MAJOR}_${_uppercomponent} REQUIRED_VARS OPENCV${MAJOR}_${_uppercomponent}_LIBRARY OPENCV${MAJOR}_${_uppercomponent}_LIBRARY_DEBUG OPENCV_INCLUDE_DIR NAME_MISMATCHED)

  MARK_AS_ADVANCED(OPENCV${MAJOR}_${_uppercomponent}_LIBRARY OPENCV${MAJOR}_${_uppercomponent}_LIBRARY_DEBUG OPENCV${MAJOR}_INCLUDE_DIR)
  
ELSE(MSVC)
  # rest of the world

  FIND_LIBRARY(OPENCV${MAJOR}_${_uppercomponent}_LIBRARY NAMES ${OPENCV_WOV_NAMES}
    HINTS
    $ENV{OPENCV_HOME}/lib
    DOC "OPENCV - Library (WOV)"
  )

  SET(OPENCV${MAJOR}_LIBRARIES ${OPENCV${MAJOR}_LIBRARIES} ${OPENCV${MAJOR}_${_uppercomponent}_LIBRARY})
  FIND_PACKAGE_HANDLE_STANDARD_ARGS(OPENCV${MAJOR}_${_uppercomponent} REQUIRED_VARS OPENCV${MAJOR}_${_uppercomponent}_LIBRARY OPENCV${MAJOR}_INCLUDE_DIR NAME_MISMATCHED)
  
  MARK_AS_ADVANCED(OPENCV${MAJOR}_${_uppercomponent}_LIBRARY OPENCV${MAJOR}_INCLUDE_DIR)
  
ENDIF(MSVC)
ENDMACRO(FIND_OPENCV_COMPONENT)

IF(COVISE_USE_OPENCV5)
    FIND_OPENCV_COMPONENT(objdetect 500)
    if (NOT OPENCV${MAJOR}_OBJDETECT_FOUND)
      FIND_OPENCV_COMPONENT(aruco 500)
    endif()
    FIND_OPENCV_COMPONENT(videoio 500)
    FIND_OPENCV_COMPONENT(core 500)
    FIND_OPENCV_COMPONENT(highgui 500)
    FIND_OPENCV_COMPONENT(imgproc 500)
    FIND_OPENCV_COMPONENT(imgcodecs 500)

    # OpenCV5 on your distro uses "calib" instead of "calib3d" and the library has been split
    FIND_OPENCV_COMPONENT(calib 500)
    FIND_OPENCV_COMPONENT(geometry 500)

    # OpenCV5 may not ship a separate libopencv_aruco
    if(NOT OPENCV${MAJOR}_ARUCO_FOUND AND OPENCV_OBJDETECT_FOUND)
        set(OPENCV${MAJOR}_ARUCO_FOUND TRUE)
        set(OPENCV${MAJOR}_ARUCO_LIBRARY "${OPENCV${MAJOR}_OBJDETECT_LIBRARY}")
    endif()

if((OPENCV${MAJOR}_ARUCO_FOUND OR OPENCV${MAJOR}_OBJDETECT_FOUND) AND OPENCV${MAJOR}_VIDEOIO_FOUND AND OPENCV${MAJOR}_CORE_FOUND
            AND OPENCV${MAJOR}_HIGHGUI_FOUND
            AND OPENCV${MAJOR}_IMGPROC_FOUND AND OPENCV${MAJOR}_CALIB_FOUND AND OPENCV${MAJOR}_GEOMETRY_FOUND)
        set(OPENCV${MAJOR}_FOUND TRUE)
    endif()
ELSEIF(COVISE_USE_OPENCV4)
    FIND_OPENCV_COMPONENT(aruco 470)
    FIND_OPENCV_COMPONENT(videoio 470)
    FIND_OPENCV_COMPONENT(core 470)
    FIND_OPENCV_COMPONENT(objdetect 470)
    FIND_OPENCV_COMPONENT(highgui 470)
    FIND_OPENCV_COMPONENT(imgproc 470)
    FIND_OPENCV_COMPONENT(imgcodecs 470)
    FIND_OPENCV_COMPONENT(calib3d 470)
    if(OPENCV${MAJOR}_ARUCO_FOUND AND OPENCV${MAJOR}_VIDEOIO_FOUND AND OPENCV${MAJOR}_CORE_FOUND
            AND OPENCV${MAJOR}_OBJDETECT_FOUND AND OPENCV${MAJOR}_HIGHGUI_FOUND
            AND OPENCV${MAJOR}_IMGPROC_FOUND AND OPENCV${MAJOR}_CALIB3D_FOUND)
        set(OPENCV${MAJOR}_FOUND TRUE)
    endif()
ELSEIF(COVISE_USE_OPENCV3)
    FIND_OPENCV_COMPONENT(aruco 310)
    FIND_OPENCV_COMPONENT(videoio 310)
    FIND_OPENCV_COMPONENT(core 310)
    FIND_OPENCV_COMPONENT(objdetect 310)
    FIND_OPENCV_COMPONENT(highgui 310)
    FIND_OPENCV_COMPONENT(imgproc 310)
    FIND_OPENCV_COMPONENT(imgcodecs 310)
    FIND_OPENCV_COMPONENT(calib3d 310)
    if(OPENCV${MAJOR}_ARUCO_FOUND AND OPENCV${MAJOR}_VIDEOIO_FOUND AND OPENCV${MAJOR}_CORE_FOUND
            AND OPENCV${MAJOR}_OBJDETECT_FOUND AND OPENCV${MAJOR}_HIGHGUI_FOUND
            AND OPENCV${MAJOR}_IMGPROC_FOUND AND OPENCV${MAJOR}_CALIB3D_FOUND)
        set(OPENCV${MAJOR}_FOUND TRUE)
    endif()
ELSE()
    FIND_OPENCV_COMPONENT(core 244)
    FIND_OPENCV_COMPONENT(objdetect 244)
    FIND_OPENCV_COMPONENT(highgui 244)
    FIND_OPENCV_COMPONENT(imgproc 244)
    if(OPENCV_CORE_FOUND AND OPENCV_OBJDETECT_FOUND AND OPENCV_HIGHGUI_FOUND AND OPENCV_IMGPROC_FOUND)
        set(OPENCV_FOUND TRUE)
    endif()
ENDIF()

IF(OPENCV${MAJOR}_FOUND)
    SET(OPENCV_INCLUDE_DIRS ${OPENCV${MAJOR}_INCLUDE_DIR})
    SET(OPENCV_LIBRARIES ${OPENCV${MAJOR}_LIBRARIES})
    SET(OPENCV_FOUND TRUE)
ENDIF()
