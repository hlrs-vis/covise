        INCLUDE_DIRECTORIES(SYSTEM ${SCHISM_INCLUDE_DIRS})
        SET(EXTRA_LIBS ${EXTRA_LIBS} ${SCHISM_LIBRARIES})
    ENDIF()
ENDMACRO(USE_LAMURE)

