MACRO(USE_LAMURE)
    COVISE_FIND_PACKAGE(SCHISM)
    IF ((NOT SCHISM_FOUND)  AND (${ARGC} LESS 1))
        USING_MESSAGE("Skipping because of missing Schism")
        RETURN()
    ENDIF((NOT SCHISM_FOUND)  AND (${ARGC} LESS 1))
    IF(NOT LAMURE_USED)
        SET(LAMURE_USED TRUE)
        INCLUDE_DIRECTORIES(SYSTEM ${SCHISM_INCLUDE_DIRS})
        SET(EXTRA_LIBS ${EXTRA_LIBS} ${SCHISM_LIBRARIES})
    ENDIF()
ENDMACRO(USE_LAMURE)

