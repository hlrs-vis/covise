<?xml version="1.0"?>

<COCONFIG version="1" >
    <GLOBAL>
        <COVER>
            <NavigationMode value="XForm" />

            <Input>
                <MouseNav value="ON" />
                <Device>
                    <joystick driver="joystick" device="/dev/input/js"/>
                </Device>
            </Input>

            <SceneSize value="100" />
            <Menu>
                <Position x="50" y="-300" z="25" />
            </Menu>
            <ViewerPosition x="0" y="-400" z="0" />
            <Stereo value="false" />

            <PipeConfig>
                <Pipe name="0" useDISPLAY="true" />
            </PipeConfig>

            <WindowConfig>
                <Window type="Qt" width="1800" comment="FRONT" window="0" pipeIndex="0" height="1200" left="100" top="100" name="0" embedded="false" decoration="true" />
            </WindowConfig>

            <ScreenConfig>
                <Screen width="600" comment="FRONT" h="0.0" originX="0" originY="0" originZ="0" height="400" p="0.0" r="0.0" name="0" screen="0" />
            </ScreenConfig>

            <ViewportConfig>
                <!-- each channel needs at least one Viewport -->
                <Viewport width="1" height="1" left="0" bottom="0" windowIndex="0" channelIndex="0" name="0"  />
            </ViewportConfig>
        </COVER>
    </GLOBAL>

    <INCLUDE global="1" configname="paul">config.paul.general.xml</INCLUDE>
</COCONFIG>
